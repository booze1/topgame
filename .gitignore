# Photos fetched by `npm run fetch-images` are not committed: they belong to
# their photographers and are re-fetchable in one command. The attribution
# manifest that the script writes is ignored for the same reason.
public/cards/*/
public/cards/attributions.json
public/cards/contact-sheet.html

